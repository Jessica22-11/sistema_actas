# ========================================
# Archivo de ejemplo de variables de entorno
# ========================================
# Copia este archivo como .env y rellena con tus valores reales
# NUNCA subas el archivo .env a GitHub

# Configuración de Django
SECRET_KEY=tu-secret-key-aqui-generala-con-django
DEBUG=True

# Base de datos (SQLite por defecto)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Configuración de Email (CREDENCIALES SENSIBLES - NO COMPARTIR)
# Usa una cuenta de Gmail con contraseña de aplicación
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion-aqui
DEFAULT_FROM_EMAIL=Sistema Actas SENA <tu-correo@gmail.com>

# API Keys (si usas IA)
OPENAI_API_KEY=tu-openai-api-key-aqui
GROQ_API_KEY=tu-groq-api-key-aqui

# Celery / Redis (si usas tareas asíncronas)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Configuración del sitio
SITE_DOMAIN=127.0.0.1:8000

# ========================================
# Notas:
# ========================================
# 1. Para Gmail, debes generar una "Contraseña de Aplicación"
#    Ve a: https://myaccount.google.com/apppasswords
# 2. Activa la verificación en 2 pasos primero
# 3. La contraseña de aplicación es de 16 caracteres
